# Copia este archivo a .env.local y rellena los valores.
# Los prefijados con VITE_ se incrustan en el bundle del navegador (no son secretos).

# Proyecto Supabase -> Settings -> API
VITE_SUPABASE_URL="https://TU-PROYECTO.supabase.co"
VITE_SUPABASE_ANON_KEY="eyJ..."

# Clave PÚBLICA VAPID para Web Push (la genera: npm run gen:vapid)
VITE_VAPID_PUBLIC_KEY="B..."

# Nombre visible de la app (opcional)
VITE_APP_NAME="Rutina Cosmética"

# ---------------------------------------------------------------------------
# Solo para las Edge Functions de Supabase (NO llevan prefijo VITE_, son
# secretos). Se configuran con `supabase secrets set`, no en este archivo.
#   VAPID_PUBLIC_KEY   = igual que VITE_VAPID_PUBLIC_KEY
#   VAPID_PRIVATE_KEY  = clave privada que genera `npm run gen:vapid`
#   VAPID_SUBJECT      = "mailto:tu-email@example.com"
# ---------------------------------------------------------------------------
